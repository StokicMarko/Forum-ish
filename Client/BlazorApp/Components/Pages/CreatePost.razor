@page "/posts/create"
@using ApiContracts.Post
@using BlazorApp.Services
@inject IPostService postService
@inject NavigationManager navigation

<PageTitle>Create a post</PageTitle>

<h1>Create post</h1>

<div class="mb-3">
    <label for="title" class="form-label">Title</label>
    <input id="title" class="form-control" @bind="title" @bind:event="oninput"/>
</div>

<div class="mb-3">
    <label for="body" class="form-label">Body</label>
    <textarea id="body" class="form-control" rows="6" @bind="body" @bind:event="oninput"></textarea>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

<button class="btn btn-primary" @onclick="CreateAsync" disabled="@isSaving">Create</button>

@code {
    private string title = "";
    private string body = "";
    private string? errorMessage;
    private bool isSaving;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(body))
        {
            errorMessage = "Title and body are required.";
            return;
        }

        isSaving = true;
        errorMessage = null;
        try
        {
            PostDTO created = await postService.AddPostAsync(new CreatePostDTO
            {
                Title = title,
                Body = body,
                UserId = CurrentUser.Id
            });
            navigation.NavigateTo($"posts/{created.Id}");
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
