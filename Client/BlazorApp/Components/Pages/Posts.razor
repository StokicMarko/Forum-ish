@page "/posts"
@using ApiContracts
@using ApiContracts.Post
@using BlazorApp.Services
@inject IPostService postService
@inject IUserService userService

<PageTitle>All the posts in the forum</PageTitle>

<h1>Posts</h1>

<p>
    <a href="posts/create">Create a new post</a>
</p>

@if (errorMessage != null)
{
    <div class="alert alert-danger">@errorMessage</div>
}
else if (posts == null)
{
    <p>
        <em>Loading...</em>
    </p>
}
else if (posts.Length == 0)
{
    <p>No posts yet.</p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Title</th>
            <th>Author</th>
        </tr>
        </thead>
        <tbody>
        @foreach (PostDTO post in posts)
        {
            <tr>
                <td>
                    <a href="posts/@post.Id">@post.Title</a>
                </td>
                <td>@AuthorName(post.UserId)</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    private PostDTO[]? posts;
    private Dictionary<int, string> usernames = new();
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            posts = await postService.GetPostsAsync();
            UserDTO[] users = await userService.GetUsersAsync();
            usernames = users.ToDictionary(u => u.Id, u => u.Username);
        }
        catch (Exception e)
        {
            errorMessage = e.Message;
        }
    }

    private string AuthorName(int userId) => usernames.GetValueOrDefault(userId, "Unknown user");
}
